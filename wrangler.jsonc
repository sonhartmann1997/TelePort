{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teleport",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "vars": {
    "WEBHOOK_URL": "https://teleport.sonhartmann-1997.workers.dev/"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}

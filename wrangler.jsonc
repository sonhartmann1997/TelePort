{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teleport",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "vars": {
    "WEBHOOK_URL": "https://teleport.sonhartmann-1997.workers.dev/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teleport-db",
      "database_id": "5a29a16f-663f-4392-85b8-461a15753829"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MOVIE_SAVED",
      "id": "12475ed9f06b4899bc2930d1a7de0ba9"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
